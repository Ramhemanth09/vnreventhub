    {
      "name": "4. Admin Management",
      "item": [
        {
          "name": "Admin: Get All Campus Registrations [SUCCESS 200]",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/registrations", "host": ["{{baseUrl}}"], "path": ["admin", "registrations"] }
          }
        },
        {
          "name": "Admin: Update Registration Status (Mark Attended) [SUCCESS 200]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ATTENDED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/registrations/{{sampleRegistrationId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "registrations", "{{sampleRegistrationId}}", "status"] }
          }
        },
        {
          "name": "Student accessing Admin Roster [FAILURE 403]",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/registrations", "host": ["{{baseUrl}}"], "path": ["admin", "registrations"] }
