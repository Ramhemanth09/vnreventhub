      "item": [
        {
          "name": "Register User [SUCCESS 201]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Adithya\",\n  \"email\": \"vikram.adithya@student.edu\",\n  \"password\": \"StudentPassword123\",\n  \"role\": \"USER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register User - Duplicate Email [FAILURE 409]",
