    },
    {
      "name": "2. Events Management",
      "item": [
        {
          "name": "Get All Events (Public / Student View) [SUCCESS 200]",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
          }
        },
        {
          "name": "Create Event - Admin [SUCCESS 201]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Quantum Computing Workshop 2026\",\n  \"description\": \"Explore quantum algorithms, Qiskit, and superposition fundamentals.\",\n  \"dateTime\": \"2026-11-20T10:00:00.000Z\",\n  \"venue\": \"Physics Seminar Hall 4\",\n  \"capacity\": 30,\n  \"status\": \"DRAFT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
          }
        },
        {
          "name": "Create Event - Student Access Denied [FAILURE 403]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Student Event\",\n  \"description\": \"Student attempting to create event\",\n  \"dateTime\": \"2026-11-20T10:00:00.000Z\",\n  \"venue\": \"Auditorium\",\n  \"capacity\": 50\n}"
            },
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
          }
        },
        {
          "name": "Publish Event - Admin [SUCCESS 200]",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/events/{{sampleEventId}}/publish", "host": ["{{baseUrl}}"], "path": ["events", "{{sampleEventId}}", "publish"] }
          }
        },
        {
          "name": "Cancel Event - Admin [SUCCESS 200]",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/events/{{sampleEventId}}/cancel", "host": ["{{baseUrl}}"], "path": ["events", "{{sampleEventId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "3. Event Registrations",
      "item": [
        {
          "name": "Register for Event [SUCCESS 201]",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/registrations/events/{{sampleEventId}}/register", "host": ["{{baseUrl}}"], "path": ["registrations", "events", "{{sampleEventId}}", "register"] }
          }
        },
        {
          "name": "Register for Event - Duplicate [FAILURE 409]",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/registrations/events/{{sampleEventId}}/register", "host": ["{{baseUrl}}"], "path": ["registrations", "events", "{{sampleEventId}}", "register"] }
          }
        },
